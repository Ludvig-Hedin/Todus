{
  "name": "todus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "go": "pnpm docker:db:up && pnpm run dev",
    "ios": "./scripts/ios/open-native-project.sh",
    "ios:simulator": "./scripts/ios/build-native-simulator.sh",
    "ios:build:preview": "./scripts/ios/build-native-simulator.sh",
    "ios:build:production": "./scripts/ios/build-native-device.sh",
    "macos": "pnpm --filter=@zero/macos dev:macos",
    "nizzy": "tsx ./packages/cli/src/cli.ts",
    "postinstall": "pnpm nizzy sync",
    "precommit": "pnpm dlx oxlint@latest --deny-warnings",
    "dev": "turbo run dev --filter=@zero/web --filter=@zero/server",
    "web": "turbo run dev --filter=@zero/web --filter=@zero/server",
    "mail": "pnpm --filter=@zero/mail dev",
    "build": "turbo run build",
    "build:frontend": "pnpm run --filter=@zero/mail build",
    "deploy:frontend": "pnpm run --filter=@zero/mail deploy",
    "deploy:backend": "pnpm run --filter=@zero/server deploy",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write apps/**/*.{ts,tsx} --log-level silent",
    "check": "pnpm run check:format && pnpm run lint",
    "check:format": "prettier . --check",
    "lint-staged": "prettier --write --ignore-unknown",
    "docker:db:up": "docker compose -f docker-compose.db.yaml up -d",
    "docker:db:stop": "docker compose -f docker-compose.db.yaml stop",
    "docker:db:down": "docker compose -f docker-compose.db.yaml down",
    "docker:db:clean": "docker compose -f docker-compose.db.yaml down -v",
    "db:generate": "dotenv -- pnpm run -C apps/server db:generate",
    "db:migrate": "dotenv -- pnpm run -C apps/server db:migrate",
    "db:push": "dotenv -- pnpm run -C apps/server db:push",
    "db:studio": "dotenv -- pnpm run -C apps/server db:studio",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org zero-7y --project nextjs ./apps/mail/.next && sentry-cli sourcemaps upload --org zero-7y --project nextjs ./apps/mail/.next",
    "scripts": "dotenv -- pnpx tsx ./scripts/run.ts",
    "test": "pnpm --filter=@zero/testing test",
    "test:watch": "pnpm --filter=@zero/testing test:watch",
    "test:coverage": "pnpm --filter=@zero/testing test:coverage",
    "test:ui": "pnpm --filter=@zero/testing test:ui",
    "test:ai": "dotenv -- pnpm --filter=@zero/server run test:ai",
    "eval": "dotenv -- pnpm --filter=@zero/server run eval",
    "eval:dev": "dotenv -- pnpm --filter=@zero/server run eval:dev",
    "eval:ci": "dotenv -- pnpm --filter=@zero/server run eval:ci",
    "android": "expo run:android",
    "parity:screenshots:check": "node ./scripts/parity/check-screenshots.mjs",
    "parity:screenshots:sync": "node ./scripts/parity/sync-screenshot-log.mjs",
    "parity:screenshots:capture:web": "node ./scripts/parity/capture-web-playwright.mjs",
    "parity:screenshots:capture:ios": "node ./scripts/parity/capture-ios-interactive.mjs",
    "parity:screenshots:capture:ios:auto": "node ./scripts/parity/capture-ios-deeplink.mjs",
    "parity:screenshots:capture:android:auto": "node ./scripts/parity/capture-android-deeplink.mjs",
    "parity:screenshots:capture:macos:auto": "node ./scripts/parity/capture-macos-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@zero/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "wrangler": "catalog:",
    "prettier": "3.6.2",
    "prettier-plugin-sort-imports": "1.8.8",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsx": "4.20.5",
    "turbo": "^2.5.6",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "react-router": "^7.6.3",
    "zod": "4.1.1",
    "zod-to-json-schema": "3.24.6",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts/*"
    ],
    "catalog": {
      "@trpc/client": "^11.1.4",
      "@trpc/server": "^11.1.4",
      "@trpc/tanstack-react-query": "^11.1.4",
      "@types/node": "^22.15.21",
      "autumn-js": "^0.0.48",
      "better-auth": "^1.3.4",
      "drizzle-kit": "0.31.4",
      "drizzle-orm": "^0.43.1",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "superjson": "^2.2.2",
      "typescript": "^5.8.3",
      "wrangler": "^4.32.0",
      "zod": "^3.25.42"
    }
  },
  "patchedDependencies": {
    "novel@1.0.2": "patches/novel.patch"
  }
}
