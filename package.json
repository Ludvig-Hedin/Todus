{
  "name": "todus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "catalog": {
    "@trpc/client": "11.4.3",
    "@trpc/server": "11.4.3",
    "@trpc/tanstack-react-query": "11.4.3",
    "@types/node": "22.15.29",
    "autumn-js": "0.0.48",
    "better-auth": "1.3.7",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.43.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "superjson": "2.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.32.0",
    "zod": "3.25.67"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@tailwindcss/oxide",
    "better-sqlite3",
    "core-js",
    "core-js-pure",
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "patchedDependencies": {
    "novel@1.0.2": "patches/novel.patch"
  },
  "scripts": {
    "go": "bun run docker:db:up && bun run dev",
    "ios": "./scripts/ios/open-native-project.sh",
    "ios:simulator": "./scripts/ios/build-native-simulator.sh",
    "ios:build:preview": "./scripts/ios/build-native-simulator.sh",
    "ios:build:production": "./scripts/ios/build-native-device.sh",
    "macos": "open apps/macos/TodusMac.xcodeproj",
    "nizzy": "tsx ./packages/cli/src/cli.ts",
    "postinstall": "bun run nizzy sync",
    "precommit": "bunx oxlint@latest --deny-warnings",
    "dev": "turbo run dev --filter=@zero/web --filter=@zero/server",
    "web": "turbo run dev --filter=@zero/web --filter=@zero/server",
    "mail": "bun run --filter=@zero/mail dev",
    "build": "turbo run build",
    "build:frontend": "bun run --filter=@zero/mail build",
    "deploy:frontend": "bun run --filter=@zero/mail deploy",
    "deploy:backend": "bun run --filter=@zero/server deploy",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write apps/**/*.{ts,tsx} --log-level silent",
    "check": "bun run check:format && bun run lint",
    "check:format": "prettier . --check",
    "lint-staged": "prettier --write --ignore-unknown",
    "docker:db:up": "docker compose -f docker-compose.db.yaml up -d",
    "docker:db:stop": "docker compose -f docker-compose.db.yaml stop",
    "docker:db:down": "docker compose -f docker-compose.db.yaml down",
    "docker:db:clean": "docker compose -f docker-compose.db.yaml down -v",
    "db:generate": "dotenv -- bun run --filter=@zero/server db:generate",
    "db:migrate": "dotenv -- bun run --filter=@zero/server db:migrate",
    "db:push": "dotenv -- bun run --filter=@zero/server db:push",
    "db:studio": "dotenv -- bun run --filter=@zero/server db:studio",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org zero-7y --project nextjs ./apps/mail/.next && sentry-cli sourcemaps upload --org zero-7y --project nextjs ./apps/mail/.next",
    "scripts": "dotenv -- bunx tsx ./scripts/run.ts",
    "test": "bun run --filter=@zero/testing test",
    "test:watch": "bun run --filter=@zero/testing test:watch",
    "test:coverage": "bun run --filter=@zero/testing test:coverage",
    "test:ui": "bun run --filter=@zero/testing test:ui",
    "test:ai": "dotenv -- bun run --filter=@zero/server test:ai",
    "eval": "dotenv -- bun run --filter=@zero/server eval",
    "eval:dev": "dotenv -- bun run --filter=@zero/server eval:dev",
    "eval:ci": "dotenv -- bun run --filter=@zero/server eval:ci",
    "android": "expo run:android",
    "parity:screenshots:check": "node ./scripts/parity/check-screenshots.mjs",
    "parity:screenshots:sync": "node ./scripts/parity/sync-screenshot-log.mjs",
    "parity:screenshots:capture:web": "node ./scripts/parity/capture-web-playwright.mjs",
    "parity:screenshots:capture:ios": "node ./scripts/parity/capture-ios-interactive.mjs",
    "parity:screenshots:capture:ios:auto": "node ./scripts/parity/capture-ios-deeplink.mjs",
    "parity:screenshots:capture:android:auto": "node ./scripts/parity/capture-android-deeplink.mjs",
    "parity:screenshots:capture:macos:auto": "node ./scripts/parity/capture-macos-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@zero/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "wrangler": "catalog:",
    "prettier": "3.6.2",
    "prettier-plugin-sort-imports": "1.8.8",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsx": "4.20.5",
    "turbo": "^2.5.6",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "react-router": "7.6.3",
    "zod": "4.1.1",
    "zod-to-json-schema": "3.24.6",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
